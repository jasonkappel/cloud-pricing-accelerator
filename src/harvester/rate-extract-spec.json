{
  "specVersion": "rate-extract-spec-v1",
  "description": "Maps each SkuMap rate key to exactly one harvested row (or a documented formula over rows) with explicit equality selectors. Region comes from the snapshot scope, which must match 'scope'.",
  "scope": {
    "azureRegion": "eastus2",
    "awsRegion": "us-east-1"
  },
  "extract": {
    "snapshotIdTemplate": "{sourceSnapshotId}-demo-extract-v2",
    "schemaVersion": "pilot-pricebook-v1",
    "nonProduction": true,
    "commercialView": "List",
    "sourceUrls": [
      "https://prices.azure.com/api/retail/prices",
      "https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/index.json",
      "https://pricing.us-east-1.amazonaws.com/savingsPlan/v1.0/aws/AWSComputeSavingsPlan/current/region_index.json"
    ],
    "noticeTemplate": "Demo extract from authenticated snapshot {sourceSnapshotId} for approved East US 2 and us-east-1 mappings. Three-year All Upfront reservation term charges are normalized over 26,280 hours, and workload-isolated commitments bill 730 hours per instance-month regardless of lower runtime. Compute Savings Plan and Reservation discounts apply only to approved VM compute lines; database compute, storage, network, and software remain at List unless separately mapped. RHEL uplift remains a documented demo assumption because that software charge is not present in the harvested Azure Retail Prices scope. Do not use this workbook as a purchasing quote."
  },
  "rates": {
    "aws.block.capacity.gb_month": {
      "sourceType": "PublishedSnapshot",
      "selectors": {
        "row": {
          "provider": "aws",
          "serviceCode": "AmazonEC2",
          "productFamily": "Storage",
          "term": "OnDemand",
          "unit": "GB-Mo",
          "dimensions": {
            "volumeApiName": "gp3",
            "usagetype": "EBS:VolumeUsage.gp3"
          }
        }
      },
      "formula": {
        "type": "price"
      },
      "places": 6,
      "record": {
        "sku": "row",
        "meter": "row",
        "row_id": "row"
      },
      "note": "gp3 capacity"
    },
    "aws.block.iops_month": {
      "sourceType": "PublishedSnapshot",
      "selectors": {
        "row": {
          "provider": "aws",
