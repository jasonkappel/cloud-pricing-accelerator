          "productFamily": "System Operation",
          "term": "OnDemand",
          "unit": "IOPS-Mo",
          "dimensions": {
            "volumeApiName": "gp3",
            "usagetype": "EBS:VolumeP-IOPS.gp3"
          }
        }
      },
      "formula": {
        "type": "price"
      },
      "places": 6,
      "record": {
        "sku": "row",
        "meter": "row",
        "row_id": "row"
      },
      "note": "gp3 provisioned IOPS"
    },
    "aws.block.throughput_mbps_month": {
      "sourceType": "PublishedSnapshot",
      "selectors": {
        "row": {
          "provider": "aws",
          "serviceCode": "AmazonEC2",
          "productFamily": "Provisioned Throughput",
          "term": "OnDemand",
          "unit": "GiBps-mo",
          "dimensions": {
            "volumeApiName": "gp3",
            "usagetype": "EBS:VolumeP-Throughput.gp3"
          }
        }
      },
      "formula": {
        "type": "scaled",
        "row": "row",
        "divide": "1024"
      },
      "places": 6,
      "record": {
        "sku": "row",
        "meter": "row",
        "row_id": "row"
      },
